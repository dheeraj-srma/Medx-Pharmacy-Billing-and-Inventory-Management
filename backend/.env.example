# Environment (production | development | staging)
ENVIRONMENT=production

# Database Configuration (PostgreSQL is required in production)
DATABASE_URL=postgresql://user:password@localhost:5432/medical_store

# JWT Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma-separated list or JSON array string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
